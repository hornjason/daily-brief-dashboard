{
  "name": "daily-brief-dashboard",
  "version": "1.5.3",
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.ts",
    "start": "bun server.ts",
    "refresh": "bun run scripts/refresh-all.ts",
    "login:rh": "bun scripts/login-rh.ts",
    "scrape:cases": "bun scripts/scrape-cases.ts",
    "test": "bun test src/**/*.test.ts",
    "test:e2e": "bunx playwright test",
    "test:unit": "bun test test/unit/",
    "test:smoke": "bun scripts/smoke-test.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bash scripts/check-empty-catches.sh"
  },
  "dependencies": {
    "googleapis": "^144.0.0",
    "hono": "^4.7.0",
    "unpdf": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "playwright-ctrf-json-reporter": "^0.0.9",
    "@types/jsdom": "^28.0.1",
    "bun-types": "^1.3.11",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1"
  }
}
