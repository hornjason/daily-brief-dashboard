# Dependencies
node_modules/
dashboard/node_modules/

# Build output
dashboard/dist/

# Runtime cache (brief caches, sheet caches)
cache/
# Exception: seed-data cache is canonical test fixtures, must be committed
!scripts/seed-data/cache/
!scripts/seed-data/cache/**

# Logs
logs/
*.log

# OAuth tokens & credentials — never commit
config/.gmail-token.json
config/.gdrive-server-credentials.json
config/.calendar-token.json
config/.sheets-token.json
config/.google-token.json
config/gcp-oauth.keys.json
config/.rh-session.json
config/.rh-chrome-profile/
data/config/
data/cache/
data/rh-profile/
**/session-state.json
**/sf-session-state.json

# Runtime state — user-specific, not source
config/data-sources.json
config/drive-watcher-state.json
config/oauth-state.json

# Environment variables
.env
.env.local
.env.*
!.env.example

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Bun
.bun/

# PAI MEMORY/WORK — project tracking, not source
MEMORY/

# Test results & Playwright state
test-results/
.playwright-cli/
dashboard/.playwright-cli/

# Claude worktrees
.claude/

# Dev/demo data directories — ephemeral snapshots of production data (BKL-UX59)
data-dev/
data-demo/

# Unsanctioned deploy files — make rebuild is the only sanctioned deploy method (BKL-H01)
docker-compose.yml

# Test container data (mutated by tests, never commit)
data-test/

# Seed data source (committed — canonical test fixtures)
# scripts/seed-data/ is intentionally tracked
