# Default environment variables — shipped inside the container image.
# These provide working defaults so new users get AI briefs out of the box.
#
# To override any value, set it in your .env file (passed via --env-file)
# or with -e flags on the podman/docker run command. User values always win.
#
# Example: to use your own GCP project instead of the shared one:
#   echo "GOOGLE_CLOUD_PROJECT=my-project-id" >> .env

# Vertex AI / Gemini — shared project for AI briefs
GOOGLE_CLOUD_PROJECT=jhorn-pai
GOOGLE_CLOUD_LOCATION=us-east1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SERVICE_ACCOUNT_

# Push notifications
NTFY_TOPIC=pai-notifications
