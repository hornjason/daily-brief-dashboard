# Dockerfile.challenge — AI Challenge image with CrowdStrike data baked in
# Built on top of the hero image. Team members: podman pull + podman run -p 7779:7777
FROM ghcr.io/hornjason/daily-brief-dashboard:latest

ENV CHALLENGE_MODE=true

# Config files (explicit per-file COPY — no directory COPYs)
COPY data-challenge/config/customers.json /data/config/customers.json
COPY data-challenge/config/aes.json /data/config/aes.json
COPY data-challenge/config/settings.json /data/config/settings.json
COPY data-challenge/config/pod-config.json /data/config/pod-config.json

# Baseline data (explicit per-file COPY)
COPY data-demo/baselines/crowdstrike/crowdstrike-cases.json /data/cache/cases.json
COPY data-demo/baselines/crowdstrike/crowdstrike-emails.json /data/cache/crowdstrike-emails.json
COPY data-demo/baselines/crowdstrike/crowdstrike-sheets.json /data/cache/crowdstrike-sheets.json
COPY data-demo/baselines/crowdstrike/intelligence-graph.json /data/cache/intelligence-graph.json
COPY data-demo/baselines/crowdstrike/intelligence-graph.previous.json /data/cache/intelligence-graph.previous.json
COPY data-demo/baselines/crowdstrike/motion.json /data/cache/motion.json

EXPOSE 7777
