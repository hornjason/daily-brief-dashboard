# Dockerfile.challenge — AI Challenge image with CrowdStrike data baked in
# Built on top of the hero image. Team members: podman pull + podman run -p 7779:7777
FROM ghcr.io/hornjason/daily-brief-dashboard:latest

ENV CHALLENGE_MODE=true

# Config files (hand-curated, credential-free — validated by build-challenge-data.sh)
COPY data-challenge/config/ /data/config/

# Full CrowdStrike cache: signals, intelligence docs, news, campaigns, global reference data
COPY data-challenge/cache/ /data/cache/

EXPOSE 7777
